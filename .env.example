# Template for `docker compose up`. Copy to .env (repository root) and fill in your own values.
# .env is git-ignored. Never commit real credentials.
# Values must not contain spaces or the "$" character.

# --- PostgreSQL container (required). Not published on the host by default. ---
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth: one shared dashboard account (all required) ---
Auth__Username=CHANGE_ME
# Generate with:  dotnet run --no-launch-profile --project IotBackend -- hash-password
Auth__PasswordHash=CHANGE_ME_PASTE_OUTPUT_OF_hash-password
# At least 32 bytes of random text, e.g. `openssl rand -base64 48`
Auth__JwtSigningKey=CHANGE_ME_AT_LEAST_32_BYTES_OF_RANDOM_TEXT
Auth__TokenLifetimeHours=24

# --- MQTT broker (Mqtt__Host is required) ---
# Option A: your own cloud broker with TLS.
Mqtt__Host=CHANGE_ME_BROKER_HOST
Mqtt__Port=8883
Mqtt__Username=CHANGE_ME
Mqtt__Password=CHANGE_ME
Mqtt__UseTls=true
# Option B: bundled local broker (run `docker compose --profile local-broker up`):
#   Mqtt__Host=mosquitto
#   Mqtt__Port=1883
#   Mqtt__Username=local
#   Mqtt__Password=local
#   Mqtt__UseTls=false
Mqtt__ClientId=iot-backend-poc
