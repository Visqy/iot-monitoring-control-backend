{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Mqtt": {
    "Host": "",
    "Port": 8883,
    "Username": "",
    "Password": "",
    "ClientId": "iot-backend-poc",
    "UseTls": true,
    "TelemetryTopic": "+/pzem",
    "StatusTopic": "+/status",
    "RelayStateTopic": "+/relay/state",
    "RfidTopic": "+/rfid",
    "RfidCardsTopic": "rfid/cards",
    "ReconnectDelaySeconds": 5
  },
  "Relay": {
    "CommandTimeoutSeconds": 30,
    "TimeoutScanIntervalSeconds": 10
  },
  "DeviceOffline": {
    "OfflineThresholdSeconds": 165,
    "SweepIntervalSeconds": 30
  },
  "Auth": {
    "Username": "",
    "PasswordHash": "",
    "JwtSigningKey": "",
    "TokenLifetimeHours": 24
  }
}
