# Template for local development (`dotnet run --project IotBackend`).
# Copy to IotBackend/.env (same folder as IotBackend.csproj) and fill in your own values.
# IotBackend/.env is git-ignored. Never commit real credentials.
# Nested configuration keys use a double underscore: Mqtt__Host maps to Mqtt:Host.

# --- PostgreSQL (required) ---
# A local database you created yourself, e.g. `createdb iot`.
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=iot;Username=CHANGE_ME;Password=CHANGE_ME;SSL Mode=Disable

# --- Auth: one shared dashboard account (all required, the app refuses to start without them) ---
Auth__Username=CHANGE_ME
# Generate with:  dotnet run --no-launch-profile --project IotBackend -- hash-password
Auth__PasswordHash=CHANGE_ME_PASTE_OUTPUT_OF_hash-password
# At least 32 bytes of random text, e.g. `openssl rand -base64 48`
Auth__JwtSigningKey=CHANGE_ME_AT_LEAST_32_BYTES_OF_RANDOM_TEXT
Auth__TokenLifetimeHours=24

# --- MQTT broker (Mqtt__Host is required: the app refuses to start without it) ---
Mqtt__Host=CHANGE_ME_BROKER_HOST
Mqtt__Port=8883
Mqtt__Username=CHANGE_ME
Mqtt__Password=CHANGE_ME
Mqtt__ClientId=iot-backend-poc
# TLS is on by default. Set to false ONLY for a local broker on loopback (see docker-compose.yml, profile "local-broker").
Mqtt__UseTls=true
